# Tempo — environment variables
#
# Tempo runs fully without any of these set. Timers, the stopwatch, and
# settings never depend on ads or an external service.
#
# Site URL used for canonical links, Open Graph tags, and the sitemap.
VITE_SITE_URL=https://tempo.example.com

# Optional display ads (e.g. Google AdSense). Leave both blank to disable
# ads entirely — the AdSlot component then renders nothing in production
# and a labelled placeholder in development.
VITE_AD_CLIENT_ID=
VITE_AD_SLOT_ID=
